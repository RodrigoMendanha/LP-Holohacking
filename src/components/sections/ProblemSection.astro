---
import Icon from "../ui/Icon.astro";

// deslocamentos da "dispersão" (x, y em %, rotação em graus) — antes de convergir
const temas = [
  { t: "Alimentação", x: -18, y: -40, r: -8 },
  { t: "Rotina", x: 30, y: 60, r: 6 },
  { t: "Sintomas", x: 62, y: -30, r: -5 },
  { t: "Comportamento", x: -40, y: 45, r: 7 },
  { t: "Emoções", x: 12, y: -70, r: -3 },
  { t: "Contexto", x: 48, y: 80, r: 9 },
  { t: "Objetivos", x: -55, y: -25, r: 5 },
  { t: "Dificuldades", x: 20, y: 30, r: -9 },
  { t: "Padrões", x: 40, y: -55, r: 4 },
];
---

<section class="secao secao--clara problema" aria-labelledby="problema-titulo">
  <div class="container problema-grade">
    <div class="problema-texto">
      <span class="eyebrow" data-reveal>O desafio</span>
      <h2 id="problema-titulo" data-reveal style="--i:1">
        Uma boa consulta gera muita informação. O desafio é transformar tudo isso em <em>direção</em>.
      </h2>
      <p data-reveal style="--i:2">
        Em um atendimento cuidadoso, o paciente fala de comida, de rotina, do corpo, do que sente e do que deseja.
        É justamente essa riqueza que pede uma estrutura: um caminho para organizar o que apareceu, decidir onde
        aprofundar e chegar ao retorno com contexto.
      </p>
      <p data-reveal style="--i:3">
        O HoloHacking foi desenhado para isso — dar forma ao que a escuta profissional já percebe.
      </p>
    </div>

    <div class="converge" data-converge aria-label="Temas de um atendimento organizados em uma estrutura" role="group">
      <ul role="list" class="converge-temas">
        {
          temas.map((t, i) => (
            <li style={`--x:${t.x}%;--y:${t.y}%;--r:${t.r}deg;--i:${i}`}>
              <span class="converge-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {t.t}
            </li>
          ))
        }
      </ul>
      <div class="converge-seta" aria-hidden="true">
        <Icon name="arrow-down" size={20} />
      </div>
      <div class="converge-estrutura">
        <span class="eyebrow">Estrutura</span>
        <ol role="list">
          <li><b>O que apareceu</b><span>organizado</span></li>
          <li><b>Onde aprofundar</b><span>priorizado</span></li>
          <li><b>Próximo passo</b><span>definido</span></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .problema-grade {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  .problema-texto h2 {
    font-size: var(--fs-h2);
    margin: 1rem 0 1.5rem;
  }
  .problema-texto p {
    font-size: var(--fs-lead);
    color: var(--texto-suave);
    max-width: 56ch;
  }
  .problema-texto p + p { margin-top: 1rem; }

  .converge {
    position: relative;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--raio);
    background: var(--creme-claro);
    border: 1px solid var(--borda);
    box-shadow: var(--sombra);
  }
  .converge-temas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .converge-temas li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0.8rem;
    border-radius: var(--raio-botao);
    border: 1px solid var(--borda-forte);
    background: #fff;
    font-size: clamp(0.78rem, 0.72rem + 0.25vw, 0.92rem);
    font-weight: 400;
    color: var(--texto);
    line-height: 1.25;
    transition:
      transform 0.9s var(--ease),
      border-color 0.8s,
      background-color 0.8s;
    transition-delay: calc(var(--i) * 45ms);
  }
  .converge-num {
    font-family: var(--fonte-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--acento);
    transition: opacity 0.5s 0.6s;
  }
  /* estado inicial: espalhado */
  :global(.js) .converge .converge-temas li {
    transform: translate(var(--x), var(--y)) rotate(var(--r));
    border-style: dashed;
    background: transparent;
  }
  :global(.js) .converge.is-visivel .converge-temas li {
    transform: none;
    border-style: solid;
    border-color: var(--linha);
    background: #fff;
  }
  :global(.js) .converge .converge-num { opacity: 0; }
  :global(.js) .converge.is-visivel .converge-num { opacity: 1; }

  .converge-seta {
    display: grid;
    place-items: center;
    margin: 1rem auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    color: var(--acento);
  }
  .converge-estrutura {
    border-radius: var(--raio-card);
    padding: 1.1rem 1.25rem 1.25rem;
    background: linear-gradient(165deg, var(--verde-escuro), var(--verde-noite));
    border: 1px solid var(--linha);
    color: var(--creme);
    transition: opacity 0.8s var(--ease) 0.75s, transform 0.8s var(--ease) 0.75s;
  }
  .converge-estrutura .eyebrow { color: var(--dourado); }
  .converge-estrutura ol { display: grid; gap: 0.4rem; margin-top: 0.6rem; }
  .converge-estrutura li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(201, 163, 90, 0.14);
  }
  .converge-estrutura li:last-child { border-bottom: 0; }
  .converge-estrutura b {
    font-family: var(--fonte-display);
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--dourado-claro);
  }
  .converge-estrutura span:not(.eyebrow) {
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(237, 232, 218, 0.6);
  }
  :global(.js) .converge .converge-estrutura { opacity: 0; transform: translateY(12px); }
  :global(.js) .converge.is-visivel .converge-estrutura { opacity: 1; transform: none; }

  @media (min-width: 1000px) {
    .problema-grade { grid-template-columns: 1fr 1fr; }
  }
</style>
