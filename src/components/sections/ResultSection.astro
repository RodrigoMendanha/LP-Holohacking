---
/* Resultado HOLOS — um dos pontos altos da página. As duas partes do
   documento, o
   caminho Resultado → PDF → WhatsApp e o CTA. As páginas são o documento
   REAL gerado pelo sistema com a paciente fictícia da fixture de testes. */
import CtaButton from "../ui/CtaButton.astro";
import Icon from "../ui/Icon.astro";
import ZoomDialog from "../ui/ZoomDialog.astro";
---

<section class="secao tema-escuro resultado" id="resultado" aria-labelledby="resultado-titulo">
  <div class="resultado-luz" aria-hidden="true"></div>
  <div class="container">
    <header class="cabeca cabeca--centro">
      <span class="eyebrow" data-reveal>Resultado HOLOS</span>
      <h2 id="resultado-titulo" data-reveal style="--i:1">
        O paciente não sai apenas com informação. <em>Sai com direção.</em>
      </h2>
      <p data-reveal style="--i:2">
        Ao final do atendimento, você transforma o que foi compreendido em um Resultado HOLOS claro para o paciente.
      </p>
    </header>

    <figure class="folhas" data-reveal aria-label="As duas partes de um Resultado HOLOS real">
      {[
        { src: "/images/product/resultado-pagina-1.webp", w: 1000, h: 1361, parte: "1 de 2",
          legenda: "Seu momento agora, foco desta fase, o que vamos trabalhar e o plano até a próxima consulta.",
          alt: "Primeira parte de um Resultado HOLOS real: seu momento agora, foco desta fase, o que vamos trabalhar e o plano até a próxima consulta, com o que fazer, quando e o que observar." },
        { src: "/images/product/resultado-pagina-2.webp", w: 1000, h: 1493, parte: "2 de 2",
          legenda: "O que foi combinado, Corpo · Mente · Espírito, o que observar, a próxima etapa e o mapa HOLOS.",
          alt: "Segunda parte de um Resultado HOLOS real: o que foi combinado, Corpo, Mente e Espírito, o que observar até o próximo encontro, a próxima etapa e o mapa HOLOS." },
      ].map((pg, i) => (
        <a
          class:list={["folha-real", `folha-real--${i + 1}`]}
          href={pg.src}
          data-zoom="resultado"
          data-zoom-titulo={`Resultado HOLOS · parte ${pg.parte}`}
          data-zoom-legenda={pg.legenda}
          data-zoom-alt={pg.alt}
          aria-label={`Ampliar a parte ${pg.parte} do Resultado HOLOS`}
        >
          <img src={pg.src} alt={pg.alt} width={pg.w} height={pg.h} loading="lazy" decoding="async" />
          <span class="folha-parte" aria-hidden="true">{pg.parte}</span>
        </a>
      ))}
      <figcaption class="mock-nota">Resultado HOLOS real · paciente fictícia · clique para ampliar</figcaption>
    </figure>

    <div class="resultado-base">
      <div class="entrega" data-reveal>
        <span class="eyebrow">Da consulta às mãos do paciente</span>
        <ol role="list" class="entrega-fluxo">
          <li><span class="icone"><Icon name="file" /></span><b>Resultado HOLOS</b></li>
          <li aria-hidden="true" class="entrega-seta"><Icon name="arrow-right" size={16} /></li>
          <li><span class="icone"><Icon name="clipboard" /></span><b>PDF</b></li>
          <li aria-hidden="true" class="entrega-seta"><Icon name="arrow-right" size={16} /></li>
          <li><span class="icone"><Icon name="message" /></span><b>WhatsApp</b></li>
        </ol>
        <p>
          O Resultado pode ser gerado em PDF e compartilhado pelo canal que você já usa com o paciente, como o
          WhatsApp.
        </p>
      </div>

      <div class="resultado-fecho" data-reveal style="--i:1">
        <p class="resultado-mensagem">
          O Resultado é construído pela nutricionista, <em>com apoio do Playbook.</em>
        </p>
        <p class="resultado-decide">O sistema organiza. Você decide.</p>
        <CtaButton location="result" />
      </div>
    </div>
  </div>
  <ZoomDialog grupo="resultado" item="Parte" />
</section>

<style>
  .resultado-luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 45% at 50% 42%, rgba(201, 163, 90, 0.14), transparent 70%);
  }
  .resultado .container { position: relative; }

  /* ---------- as duas páginas (inspiradas no .relatorio do produto) ---------- */
  .folhas {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    max-width: 1080px;
    margin: 0 auto;
  }
  .folha-real {
    position: relative;
    display: block;
    border-radius: var(--raio);
    overflow: hidden;
    border: 1px solid rgba(201, 163, 90, 0.45);
    background: var(--verde-noite);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.45);
    cursor: zoom-in;
    transition: transform 0.35s var(--ease), border-color 0.35s;
  }
  .folha-real:hover { transform: translateY(-4px); border-color: var(--dourado); }
  .folha-real img { width: 100%; height: auto; }
  .folha-parte {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--raio-pilula);
    background: rgba(6, 35, 26, 0.88);
    border: 1px solid rgba(201, 163, 90, 0.5);
    color: var(--dourado-claro);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }
  .folhas .mock-nota { grid-column: 1 / -1; }

  /* ---------- entrega e fecho ---------- */
  .resultado-base {
    display: grid;
    gap: 1.5rem;
    max-width: 1080px;
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) auto 0;
    align-items: center;
  }
  .entrega {
    padding: 1.5rem;
    border-radius: var(--raio-card);
    border: 1px solid rgba(201, 163, 90, 0.26);
    background: rgba(244, 239, 227, 0.035);
  }
  .entrega-fluxo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 1.1rem 0;
  }
  .entrega-fluxo li:not(.entrega-seta) {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .entrega-fluxo b {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--creme);
  }
  .entrega-seta { color: rgba(201, 163, 90, 0.6); }
  .entrega p { font-size: 0.88rem; color: var(--texto-suave); }

  .resultado-fecho { display: grid; gap: 1rem; justify-items: start; }
  .resultado-mensagem {
    font-family: var(--fonte-display);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.85rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--creme);
    padding-left: 1.25rem;
    border-left: 2px solid var(--dourado);
  }
  .resultado-decide {
    padding-left: 1.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dourado);
  }

  @media (max-width: 479px) {
    .entrega-fluxo .icone { width: 40px; height: 40px; }
  }
  @media (min-width: 860px) {
    .folhas { grid-template-columns: 1fr 1fr; align-items: start; }
    .folha-real--2 { margin-top: 3rem; }
    .resultado-base { grid-template-columns: 1.1fr 0.9fr; }
  }
</style>
