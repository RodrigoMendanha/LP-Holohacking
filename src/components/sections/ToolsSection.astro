---
import Icon, { type IconName } from "../ui/Icon.astro";

// Nomes do produto; descrições encurtadas a partir das descrições dele.
const pilares: { nome: string; icone: IconName; ferramentas: { t: string; d: string }[] }[] = [
  {
    nome: "Corpo",
    icone: "leaf",
    ferramentas: [
      { t: "OQ³", d: "Desejo, necessidade e capacidade." },
      { t: "Linha do Momentum", d: "O momento de vida e o que dá para sustentar." },
      { t: "Mapa da Rotina", d: "Como o dia e a semana realmente acontecem." },
    ],
  },
  {
    nome: "Mente",
    icone: "brain",
    ferramentas: [
      { t: "PQQ", d: "Os porquês por trás dos objetivos." },
      { t: "Mapa de Crenças Alimentares", d: "As crenças sobre a comida." },
      { t: "Gatilhos & Respostas", d: "Gatilho, pensamento, emoção e resposta." },
    ],
  },
  {
    nome: "Espírito",
    icone: "sun",
    ferramentas: [
      { t: "Mapa do Propósito", d: "Clareza e direção para o plano." },
      { t: "Roda Holística da Vida", d: "As áreas da vida em equilíbrio." },
      { t: "Carta ao Futuro Eu", d: "Conexão com quem o paciente deseja ser." },
    ],
  },
];
---

<section class="secao secao--clara ferramentas" id="ferramentas" aria-labelledby="ferramentas-titulo">
  <div class="container">
    <header class="cabeca">
      <span class="eyebrow" data-reveal>Ferramentas de aprofundamento</span>
      <h2 id="ferramentas-titulo" data-reveal style="--i:1">Aprofunde apenas <em>onde fizer sentido.</em></h2>
      <p data-reveal style="--i:2">
        Quando algo merece mais atenção, você escolhe ferramentas de Corpo, Mente e Espírito para aprofundar o
        atendimento.
      </p>
    </header>

    <div class="pilares">
      {
        pilares.map((p, i) => (
          <article class="pilar card card--hover" data-reveal style={`--i:${i}`} aria-labelledby={`pilar-${i}`}>
            <div class="pilar-topo">
              <span class="icone">
                <Icon name={p.icone} />
              </span>
              <h3 id={`pilar-${i}`}>{p.nome}</h3>
            </div>
            <ul role="list">
              {p.ferramentas.map((f) => (
                <li>
                  <b>{f.t}</b>
                  <span>{f.d}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="ferramentas-nota" data-reveal>
      <span class="filete" aria-hidden="true"></span>
      <span>Você escolhe a ferramenta de acordo com o atendimento. <em>Não é necessário aplicar tudo.</em></span>
    </p>
  </div>
</section>

<style>
  .pilares {
    display: grid;
    gap: 1.25rem;
  }
  .pilar { background: var(--creme-claro); }
  .pilar-topo {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--linha);
  }
  .pilar h3 {
    font-size: 2rem;
    font-weight: 600;
  }
  .pilar li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--borda);
  }
  .pilar li:last-child { border-bottom: 0; padding-bottom: 0; }
  .pilar b {
    display: block;
    font-family: var(--fonte-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--titulo);
    margin-bottom: 0.25rem;
  }
  .pilar li span {
    font-size: 0.9rem;
    color: var(--texto-suave);
    line-height: 1.55;
  }

  .ferramentas-nota {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 760px;
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) auto 0;
    font-family: var(--fonte-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--titulo);
  }
  .ferramentas-nota .filete { flex-shrink: 0; width: 48px; }
  .ferramentas-nota em { color: var(--acento); }

  @media (min-width: 900px) {
    .pilares { grid-template-columns: repeat(3, 1fr); }
  }
</style>
