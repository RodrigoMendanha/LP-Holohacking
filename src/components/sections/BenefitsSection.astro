---
import Icon, { type IconName } from "../ui/Icon.astro";

const beneficios: { t: string; d: string; i: IconName }[] = [
  { t: "Mais organização", d: "Cada etapa tem um lugar.", i: "grid" },
  { t: "Mais clareza para priorizar", d: "Você enxerga onde vale aprofundar.", i: "target" },
  { t: "Continuidade entre consultas", d: "O retorno parte do que já foi construído.", i: "refresh" },
  { t: "Informações menos dispersas", d: "Mapeamento, ferramentas e histórico reunidos.", i: "layers" },
  { t: "Estratégias mais estruturadas", d: "Possibilidades organizadas para apoiar sua decisão.", i: "compass" },
  { t: "Uma entrega que torna o raciocínio visível", d: "O paciente recebe um Resultado claro e personalizado.", i: "file" },
];
---

<section class="secao secao--creme-claro beneficios" aria-labelledby="beneficios-titulo">
  <div class="container">
    <header class="cabeca cabeca--centro">
      <span class="eyebrow" data-reveal>Benefícios</span>
      <h2 id="beneficios-titulo" data-reveal style="--i:1">O que muda <em>na prática.</em></h2>
    </header>

    <ul role="list" class="beneficios-grade">
      {
        beneficios.map((b, i) => (
          <li class="card card--hover beneficio" data-reveal style={`--i:${i % 3}`}>
            <span class="icone">
              <Icon name={b.i} />
            </span>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .beneficios-grade {
    display: grid;
    gap: 1rem;
  }
  .beneficio { background: #fff; }
  .beneficio h3 {
    font-size: 1.35rem;
    margin: 1.1rem 0 0.4rem;
  }
  .beneficio p {
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  @media (min-width: 640px) {
    .beneficios-grade { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  @media (min-width: 1100px) {
    .beneficios-grade { grid-template-columns: repeat(3, 1fr); }
  }
</style>
