---
import Radar from "../ui/Radar.astro";
import Triad from "../ui/Triad.astro";
import Icon from "../ui/Icon.astro";
import { HOLOSCAN_QUESTIONS } from "../../data/site";

// Mesma ordem e mesmos rótulos curtos do radar do produto.
const sistemas = [
  "Sistema Fúngico",
  "Sistema Ácido-Inflamatório",
  "Sistema Metabólico",
  "Sistema Detox + Linfático",
  "Sistema Mental-Emocional-Espiritual",
];
const rotulos = ["Fúngico", "Inflamatório", "Metabólico", "Detox", "Mental"];
---

<section class="secao tema-escuro holoscan" id="holoscan" aria-labelledby="holoscan-titulo">
  <div class="holoscan-luz" aria-hidden="true"></div>
  <div class="container">
    <header class="cabeca cabeca--centro">
      <span class="eyebrow" data-reveal>HOLOSCAN</span>
      <h2 id="holoscan-titulo" data-reveal style="--i:1">
        Uma leitura integral para saber <em>onde aprofundar.</em>
      </h2>
      <p data-reveal style="--i:2">
        O HOLOSCAN é uma tecnologia de leitura integral baseada em {HOLOSCAN_QUESTIONS} perguntas. Ele organiza os
        relatos do paciente para ajudar o profissional a visualizar áreas que merecem maior investigação.
      </p>
    </header>

    <div class="holoscan-grade">
      <figure class="painel holoscan-painel" data-reveal>
        <div class="holoscan-painel-topo">
          <span class="eyebrow">Leitura integral</span>
          <span class="pilula">Ilustração</span>
        </div>
        <div class="holoscan-radar">
          <Radar
            values={[6.8, 5.2, 7.9, 6.1, 7.4]}
            labels={rotulos}
            size={420}
            title="Radar HOLOSCAN ilustrativo, com os cinco sistemas e valores fictícios"
          />
        </div>
        <figcaption class="holoscan-legenda">Valores fictícios · peça ilustrativa</figcaption>
      </figure>

      <ul role="list" class="metricas">
        <li class="metrica" data-reveal style="--i:0">
          <span class="metrica-num numero">{HOLOSCAN_QUESTIONS}</span>
          <span class="metrica-rot">perguntas</span>
          <span class="metrica-desc">respondidas pelo paciente</span>
        </li>
        <li class="metrica" data-reveal style="--i:1">
          <span class="metrica-num numero">5</span>
          <span class="metrica-rot">sistemas</span>
          <span class="metrica-desc">que organizam a leitura em territórios</span>
        </li>
        <li class="metrica" data-reveal style="--i:2">
          <span class="metrica-num numero metrica-num--texto">Índice <em>HOLOS</em></span>
          <span class="metrica-rot">visão de conjunto</span>
          <span class="metrica-desc">uma síntese da leitura, de 0 a 100</span>
        </li>
        <li class="metrica" data-reveal style="--i:3">
          <span class="metrica-num numero metrica-num--texto">Corpo · Mente · Espírito</span>
          <span class="metrica-rot">tríade</span>
          <span class="metrica-desc">as três dimensões do método</span>
        </li>
        <li class="metrica metrica--larga" data-reveal style="--i:4">
          <div>
            <span class="metrica-rot">Prioridades de investigação</span>
            <span class="metrica-desc">O que pede um olhar mais atento — para você decidir por onde começar.</span>
          </div>
          <ol role="list" class="prioridades" aria-hidden="true">
            <li><b>1</b><span class="esqueleto" style="width:84%"></span></li>
            <li><b>2</b><span class="esqueleto" style="width:66%"></span></li>
            <li><b>3</b><span class="esqueleto" style="width:74%"></span></li>
          </ol>
        </li>
      </ul>
    </div>

    <div class="holoscan-base">
      <div class="sistemas" data-reveal>
        <span class="eyebrow">Os cinco sistemas</span>
        <h3>Territórios de leitura, <em>não diagnósticos.</em></h3>
        <p>Cada sistema reúne relatos que costumam caminhar juntos e indica onde olhar com mais atenção.</p>
        <ol role="list">
          {
            sistemas.map((s, i) => (
              <li>
                <span class="numero">{String(i + 1).padStart(2, "0")}</span>
                {s}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="triade-bloco" data-reveal style="--i:1">
        <span class="eyebrow">Tríade</span>
        <h3>Corpo · Mente · <em>Espírito</em></h3>
        <p>A mesma leitura também é vista pelas três dimensões que dão nome ao método.</p>
        <div class="triade-figura">
          <Triad size={300} />
        </div>
      </div>
    </div>

    <p class="seguranca" data-reveal>
      <Icon name="shield" size={18} />
      <span>
        O HOLOSCAN organiza informações e prioridades de investigação. Não substitui diagnóstico clínico, exames ou
        julgamento profissional.
      </span>
    </p>
  </div>
</section>

<style>
  .holoscan { background: var(--verde-noite) !important; }
  .holoscan-luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 30% 35%, rgba(201, 163, 90, 0.14), transparent 70%),
      radial-gradient(ellipse 60% 50% at 90% 100%, rgba(20, 80, 59, 0.6), transparent 65%);
  }
  .holoscan .container { position: relative; }

  .holoscan-grade {
    display: grid;
    gap: 1.5rem;
  }
  .holoscan-painel {
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
  }
  .holoscan-painel-topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .holoscan-radar {
    max-width: 520px;
    margin: 1rem auto 0;
  }
  .holoscan-legenda {
    text-align: center;
    margin-top: 0.75rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 232, 218, 0.45);
  }

  .metricas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .metrica {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.3rem 1.25rem;
    border-radius: var(--raio-card);
    border: 1px solid rgba(201, 163, 90, 0.26);
    background: rgba(244, 239, 227, 0.035);
  }
  .metrica-num {
    font-size: var(--fs-numero);
    font-weight: 600;
    color: var(--dourado-claro);
    margin-bottom: 0.4rem;
  }
  .metrica-num--texto {
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 1.9rem);
    line-height: 1.15;
  }
  .metrica-num em { font-style: italic; font-weight: 500; color: var(--dourado); }
  .metrica-rot {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dourado);
  }
  .metrica-desc {
    font-size: 0.86rem;
    color: var(--texto-suave);
    line-height: 1.5;
  }
  .metrica--larga {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    border-color: var(--dourado);
    background: rgba(201, 163, 90, 0.08);
  }
  .prioridades { display: grid; gap: 0.6rem; color: var(--creme); }
  .prioridades li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    align-items: center;
    gap: 0.6rem;
  }
  .prioridades b {
    font-family: var(--fonte-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--dourado);
  }
  .prioridades .esqueleto { opacity: 0.2; }

  .holoscan-base {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .sistemas,
  .triade-bloco {
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border-radius: var(--raio);
    border: 1px solid rgba(201, 163, 90, 0.2);
    background: rgba(201, 163, 90, 0.04);
  }
  .sistemas h3,
  .triade-bloco h3 {
    font-size: var(--fs-h3);
    margin: 0.75rem 0 0.6rem;
  }
  .sistemas > p,
  .triade-bloco > p {
    color: var(--texto-suave);
    font-size: 0.95rem;
    max-width: 48ch;
  }
  .sistemas ol { margin-top: 1.5rem; }
  .sistemas li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid rgba(201, 163, 90, 0.14);
    font-family: var(--fonte-display);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 500;
    color: var(--creme);
  }
  .sistemas li .numero {
    font-size: 1rem;
    font-weight: 600;
    color: var(--dourado);
    min-width: 1.6rem;
  }
  .triade-figura {
    max-width: 320px;
    margin: 1.25rem auto 0;
  }

  .seguranca {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 760px;
    margin: 2.5rem auto 0;
    padding: 1rem 1.25rem;
    border-left: 2px solid rgba(201, 163, 90, 0.5);
    font-size: 0.86rem;
    color: var(--texto-suave);
    line-height: 1.6;
  }
  .seguranca :global(svg) { flex-shrink: 0; color: var(--dourado); margin-top: 0.15rem; }

  @media (max-width: 479px) {
    .metricas { grid-template-columns: 1fr; }
  }
  @media (min-width: 1000px) {
    .holoscan-grade { grid-template-columns: 1.1fr 0.9fr; align-items: stretch; }
    .holoscan-base { grid-template-columns: 1.15fr 0.85fr; }
  }
</style>
