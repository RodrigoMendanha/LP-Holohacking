---
/* RODRIGO / ORIGEM — conteúdo em CREATOR_* (data/site.ts), copiado do site
   da Formação em Nutrição Holística. Sem CREATOR_NAME, a seção mostra só o
   texto institucional sobre o método — nunca uma biografia inventada. */
import {
  CREATOR_TITLE,
  CREATOR_IMAGE_ALT,
  CREATOR_NAME,
  CREATOR_ROLE,
  CREATOR_IMAGE,
  CREATOR_BIO,
  CREATOR_METHOD_ORIGIN,
  CREATOR_WHY,
  CREATOR_CREDENTIALS,
} from "../../data/site";

const temCriador = Boolean(CREATOR_NAME);
---

<section class="secao secao--creme-claro criador" id="criador" aria-labelledby="criador-titulo">
  <div class:list={["container", "criador-grade", { "criador-grade--sem-foto": !CREATOR_IMAGE }]}>
    <div class="criador-retrato" data-reveal>
      {
        CREATOR_IMAGE ? (
          <img
            src={CREATOR_IMAGE}
            alt={CREATOR_IMAGE_ALT || (CREATOR_NAME ? `Retrato de ${CREATOR_NAME}` : "")}
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="criador-marca" aria-hidden="true">
            <img src="/images/brand/logo-holohacking.png" alt="" width="140" height="140" loading="lazy" />
          </div>
        )
      }
    </div>

    <div class="criador-texto">
      {
        temCriador ? (
          <>
            <span class="eyebrow" data-reveal>Por trás da plataforma</span>
            <h2 id="criador-titulo" data-reveal style="--i:1">{CREATOR_TITLE || CREATOR_NAME}</h2>
            {CREATOR_TITLE && <p class="criador-nome" data-reveal style="--i:2">{CREATOR_NAME}</p>}
            {CREATOR_ROLE && <p class="criador-papel" data-reveal style="--i:2">{CREATOR_ROLE}</p>}
            <div class="criador-bio">
              {CREATOR_BIO.map((p) => (
                <p data-reveal>{p}</p>
              ))}
            </div>
            {CREATOR_METHOD_ORIGIN.length > 0 && (
              <div class="criador-bloco" data-reveal>
                <h3>A origem do método</h3>
                {CREATOR_METHOD_ORIGIN.map((p) => <p>{p}</p>)}
              </div>
            )}
            {CREATOR_WHY.length > 0 && (
              <div class="criador-bloco" data-reveal>
                <h3>Por que o HoloHacking</h3>
                {CREATOR_WHY.map((p) => <p>{p}</p>)}
              </div>
            )}
            {CREATOR_CREDENTIALS.length > 0 && (
              <ul role="list" class="criador-credenciais" data-reveal>
                {CREATOR_CREDENTIALS.map((c) => <li>{c}</li>)}
              </ul>
            )}
          </>
        ) : (
          <>
            {/* [CONTEÚDO DO RODRIGO SERÁ ADICIONADO] — texto institucional provisório, sem biografia. */}
            <span class="eyebrow" data-reveal>Por trás da plataforma</span>
            <h2 id="criador-titulo" data-reveal style="--i:1">
              Um método antes de <em>uma plataforma.</em>
            </h2>
            <p data-reveal style="--i:2">
              O HoloHacking nasce da Nutrição Holística — um método que integra corpo, mente e espírito para
              compreender o comportamento alimentar e conduzir pacientes com profundidade, ciência e propósito.
            </p>
            <p data-reveal style="--i:3">
              A plataforma existe para que esse método caiba na rotina real de quem atende.
            </p>
          </>
        )
      }
      {!temCriador && <p class="criador-assinatura" data-reveal>Corpo · Mente · Espírito — em equilíbrio, em propósito.</p>}
    </div>
  </div>
</section>

<style>
  /* overflow:hidden (de .secao) impediria a foto fixa; clip corta igual sem criar rolagem */
  .criador { overflow: clip; }
  .criador-grade {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }
  .criador-retrato {
    width: min(100%, 420px);
    margin-inline: auto;
  }
  .criador-retrato > img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--raio);
    box-shadow: var(--sombra-forte);
  }
  .criador-marca {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(201, 163, 90, 0.18), transparent 65%),
      linear-gradient(165deg, var(--verde-escuro), var(--verde-noite));
    border: 1px solid var(--linha);
    box-shadow: var(--sombra-forte), 0 0 0 14px rgba(201, 163, 90, 0.06);
  }
  .criador-marca img { width: 38%; height: auto; }
  .criador-texto h2 {
    font-size: var(--fs-h2);
    margin: 1rem 0 1.5rem;
  }
  .criador-texto p:not(.criador-assinatura):not(.criador-papel) {
    font-size: var(--fs-lead);
    color: var(--texto-suave);
    max-width: 58ch;
  }
  .criador-texto p + p { margin-top: 1rem; }
  .criador-nome {
    font-family: var(--fonte-display);
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.7rem) !important;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--acento) !important;
    margin: -0.5rem 0 1.5rem;
  }
  .criador-texto .criador-bio p {
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .criador-texto .criador-bio p + p { margin-top: 0.9rem; }
  .criador-bloco { margin-top: 1.75rem; }
  .criador-bloco h3 {
    font-size: var(--fs-h4);
    margin-bottom: 0.5rem;
  }
  .criador-credenciais {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--dourado);
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .criador-papel {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--acento);
    font-weight: 500;
  }
  .criador-assinatura {
    margin-top: 2rem !important;
    font-family: var(--fonte-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--acento);
  }
  @media (min-width: 900px) {
    .criador-grade { grid-template-columns: 0.8fr 1.2fr; }
    .criador-grade--sem-foto { grid-template-columns: 0.6fr 1.4fr; }
    /* com a história longa, a foto acompanha a leitura */
    .criador-grade:not(.criador-grade--sem-foto) { align-items: start; }
    .criador-grade:not(.criador-grade--sem-foto) .criador-retrato {
      position: sticky;
      top: 104px;
    }
  }
</style>
