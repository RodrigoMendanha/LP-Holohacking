---
import ZoomDialog from "../ui/ZoomDialog.astro";
import { PLAYBOOK_SYSTEMS, PLAYBOOK_FOCI, PLAYBOOK_STRATEGIES } from "../../data/site";

---

<section class="secao secao--creme-claro playbook" id="playbook" aria-labelledby="playbook-titulo">
  <div class="container playbook-grade">
    <div class="playbook-texto">
      <span class="eyebrow" data-reveal>Playbook HOLOS</span>
      <h2 id="playbook-titulo" data-reveal style="--i:1">Da investigação para a <em>estratégia.</em></h2>
      <p class="playbook-lead" data-reveal style="--i:2">
        Depois de investigar e aprofundar, o desafio é transformar o que apareceu em uma direção prática. O Playbook
        HOLOS organiza possibilidades de foco e estratégias para apoiar essa decisão.
      </p>

      <dl class="playbook-numeros">
        <div data-reveal style="--i:0">
          <dt>sistemas</dt>
          <dd class="numero">{PLAYBOOK_SYSTEMS}</dd>
        </div>
        <div data-reveal style="--i:1">
          <dt>focos</dt>
          <dd class="numero">{PLAYBOOK_FOCI}</dd>
        </div>
        <div data-reveal style="--i:2">
          <dt>estratégias</dt>
          <dd class="numero">{PLAYBOOK_STRATEGIES}</dd>
        </div>
        <div class="playbook-naturezas" data-reveal style="--i:3">
          <dt>naturezas</dt>
          <dd class="numero numero--texto">Ação · Observação · Reflexão</dd>
        </div>
      </dl>

      <blockquote class="playbook-mensagem" data-reveal>
        <p>O Playbook orienta. <em>A decisão continua sendo profissional.</em></p>
      </blockquote>
      <p class="playbook-escolha" data-reveal>Nada vai para o paciente sem a sua escolha.</p>
    </div>

    <figure class="playbook-visual" data-reveal style="--i:2">
      <a
        class="tela-real"
        href="/images/product/playbook-focos.webp"
        data-zoom="playbook"
        data-zoom-titulo="Playbook HOLOS · Foco desta fase"
        data-zoom-legenda="Os focos sugeridos vêm das áreas prioritárias do HOLOSCAN. Você escolhe um."
        data-zoom-alt="Tela real do Playbook HOLOS: focos sugeridos para as duas áreas prioritárias do HOLOSCAN."
        aria-label="Ampliar a tela do Playbook HOLOS"
      >
        <img
          src="/images/product/playbook-focos.webp"
          alt="Tela real do Playbook HOLOS, passo “Foco desta fase”: três focos sugeridos para a área Metabólica e três para Detox e Linfático, um deles escolhido pela nutricionista."
          width="1400"
          height="852"
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption class="mock-nota">Tela real do sistema · paciente fictícia · clique para ampliar</figcaption>
    </figure>
  </div>
  <ZoomDialog grupo="playbook" item="Tela" />
</section>

<style>
  .playbook-grade {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  .playbook-texto h2 {
    font-size: var(--fs-h2);
    margin: 1rem 0 1.5rem;
  }
  .playbook-lead {
    font-size: var(--fs-lead);
    color: var(--texto-suave);
    max-width: 54ch;
  }
  .playbook-numeros {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 2.25rem;
    border-radius: var(--raio-card);
    overflow: hidden;
    border: 1px solid var(--linha);
    background: var(--linha);
  }
  .playbook-numeros .playbook-naturezas { grid-column: 1 / -1; }
  .playbook-escolha {
    margin-top: 1rem;
    padding-left: 1.4rem;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--texto-suave);
  }
  .playbook-numeros div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem;
    background: #fff;
  }
  .playbook-numeros dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--acento);
  }
  .playbook-numeros dd {
    font-size: var(--fs-numero);
    font-weight: 600;
    color: var(--titulo);
  }
  .playbook-numeros .numero--texto {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.2;
  }
  .playbook-mensagem {
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--dourado);
    font-family: var(--fonte-display);
    font-size: clamp(1.35rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--titulo);
  }
  .playbook-mensagem em { color: var(--acento); }

  .tela-real {
    display: block;
    border-radius: var(--raio);
    overflow: hidden;
    border: 1px solid var(--linha);
    background: #0b3326;
    padding: clamp(0.5rem, 0.3rem + 0.8vw, 1rem);
    box-shadow: var(--sombra-forte);
    cursor: zoom-in;
    transition: transform 0.35s var(--ease), border-color 0.35s;
  }
  .tela-real:hover { transform: translateY(-4px); border-color: var(--dourado); }
  .tela-real img { width: 100%; height: auto; }

  @media (min-width: 1000px) {
    .playbook-grade { grid-template-columns: 1fr 1fr; }
  }
</style>
