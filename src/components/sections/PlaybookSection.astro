---
import Icon from "../ui/Icon.astro";
import { PLAYBOOK_STRATEGIES } from "../../data/site";

// Cartões ilustrativos: só etiquetas e linhas-esqueleto — nenhuma estratégia
// clínica inventada.
const cartoes = [
  { dim: "Corpo", tipo: "Ação", sel: true, w: [86, 64] },
  { dim: "Mente", tipo: "Observação", sel: false, w: [78, 52] },
  { dim: "Espírito", tipo: "Reflexão", sel: true, w: [82, 60] },
];
---

<section class="secao secao--creme-claro playbook" id="playbook" aria-labelledby="playbook-titulo">
  <div class="container playbook-grade">
    <div class="playbook-texto">
      <span class="eyebrow" data-reveal>Playbook de Estratégias HOLOS</span>
      <h2 id="playbook-titulo" data-reveal style="--i:1">Da investigação para a <em>estratégia.</em></h2>
      <p class="playbook-lead" data-reveal style="--i:2">
        O Playbook de Estratégias HOLOS organiza caminhos possíveis a partir do que apareceu no atendimento — para
        que a conduta tenha estrutura, sem perder a sua assinatura.
      </p>

      <dl class="playbook-numeros">
        <div data-reveal style="--i:0">
          <dt>estratégias</dt>
          <dd class="numero">{PLAYBOOK_STRATEGIES}</dd>
        </div>
        <div data-reveal style="--i:1">
          <dt>sistemas</dt>
          <dd class="numero">5</dd>
        </div>
        <div data-reveal style="--i:2">
          <dt>dimensões</dt>
          <dd class="numero numero--texto">Corpo · Mente · Espírito</dd>
        </div>
        <div data-reveal style="--i:3">
          <dt>naturezas</dt>
          <dd class="numero numero--texto">Ação · Observação · Reflexão</dd>
        </div>
      </dl>

      <blockquote class="playbook-mensagem" data-reveal>
        <p>O Playbook orienta. <em>A decisão continua sendo profissional.</em></p>
      </blockquote>
    </div>

    <figure class="playbook-visual" data-reveal style="--i:2">
      <div class="pb-painel" aria-hidden="true">
        <div class="pb-topo">
          <span class="eyebrow">Estratégias possíveis</span>
          <span class="pb-filtros">
            <span class="pilula">Sistema</span>
            <span class="pilula">Dimensão</span>
          </span>
        </div>
        <ul role="list" class="pb-cartoes">
          {
            cartoes.map((c) => (
              <li class:list={["pb-cartao", { "pb-cartao--sel": c.sel }]}>
                <div class="pb-tags">
                  <span>{c.dim}</span>
                  <span>{c.tipo}</span>
                </div>
                <span class="esqueleto pb-titulo" style={`width:${c.w[0]}%`} />
                <span class="esqueleto" style={`width:${c.w[1]}%`} />
                <span class="pb-sel">
                  {c.sel ? (
                    <>
                      <Icon name="check" size={14} /> escolhida pela nutricionista
                    </>
                  ) : (
                    <>
                      <Icon name="plus" size={14} /> considerar
                    </>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption class="mock-nota">Ilustração · conteúdo das estratégias omitido</figcaption>
    </figure>
  </div>
</section>

<style>
  .playbook-grade {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  .playbook-texto h2 {
    font-size: var(--fs-h2);
    margin: 1rem 0 1.5rem;
  }
  .playbook-lead {
    font-size: var(--fs-lead);
    color: var(--texto-suave);
    max-width: 54ch;
  }
  .playbook-numeros {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 2.25rem;
    border-radius: var(--raio-card);
    overflow: hidden;
    border: 1px solid var(--linha);
    background: var(--linha);
  }
  .playbook-numeros div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem;
    background: #fff;
  }
  .playbook-numeros dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--acento);
  }
  .playbook-numeros dd {
    font-size: var(--fs-numero);
    font-weight: 600;
    color: var(--titulo);
  }
  .playbook-numeros .numero--texto {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.2;
  }
  .playbook-mensagem {
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--dourado);
    font-family: var(--fonte-display);
    font-size: clamp(1.35rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--titulo);
  }
  .playbook-mensagem em { color: var(--acento); }

  .pb-painel {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--raio);
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(201, 163, 90, 0.14), transparent 60%),
      linear-gradient(165deg, var(--verde-escuro), var(--verde-noite));
    border: 1px solid var(--linha);
    box-shadow: var(--sombra-forte);
    color: var(--creme);
  }
  .pb-topo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .pb-topo .eyebrow { color: var(--dourado); }
  .pb-filtros { display: flex; gap: 0.4rem; }
  .pb-filtros .pilula { color: var(--dourado-claro); font-size: 0.6rem; }
  .pb-cartoes { display: grid; gap: 0.75rem; }
  .pb-cartao {
    display: grid;
    gap: 0.55rem;
    padding: 1rem 1.1rem;
    border-radius: var(--raio-card);
    border: 1px solid rgba(201, 163, 90, 0.2);
    background: rgba(244, 239, 227, 0.04);
    color: var(--creme);
  }
  .pb-cartao--sel {
    border-color: var(--dourado);
    background: rgba(201, 163, 90, 0.09);
  }
  .pb-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .pb-tags span {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dourado);
    padding: 0.2rem 0.55rem;
    border-radius: var(--raio-pilula);
    border: 1px solid rgba(201, 163, 90, 0.35);
  }
  .pb-cartao .esqueleto { opacity: 0.2; }
  .pb-cartao .pb-titulo { height: 10px; opacity: 0.32; }
  .pb-sel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgba(237, 232, 218, 0.55);
  }
  .pb-cartao--sel .pb-sel { color: var(--dourado-claro); }

  @media (min-width: 1000px) {
    .playbook-grade { grid-template-columns: 1fr 1fr; }
  }
</style>
