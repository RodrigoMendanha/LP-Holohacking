---
import Icon, { type IconName } from "../ui/Icon.astro";

const etapas: { t: string; d: string; i: IconName; destaque?: boolean }[] = [
  { t: "Mapeamento Holístico", d: "Contexto antes do encontro.", i: "map" },
  { t: "Atendimento", d: "A escuta profissional, com o mapa em mãos.", i: "user" },
  { t: "HOLOSCAN", d: "Leitura integral e prioridades de investigação.", i: "target", destaque: true },
  { t: "Ferramentas", d: "Aprofundamento onde fizer sentido.", i: "layers" },
  { t: "Playbook", d: "Estratégias possíveis, organizadas.", i: "book" },
  { t: "Resultado HOLOS", d: "A direção da fase, construída por você.", i: "file", destaque: true },
  { t: "PDF / WhatsApp", d: "A entrega chega às mãos do paciente.", i: "message" },
  { t: "Retorno", d: "O encontro seguinte começa com contexto.", i: "calendar" },
  { t: "Evolução", d: "Antes e agora, lado a lado.", i: "chart", destaque: true },
];
---

<section class="secao secao--creme-claro jornada" id="jornada" aria-labelledby="jornada-titulo">
  <div class="container">
    <header class="cabeca">
      <span class="eyebrow" data-reveal>A jornada</span>
      <h2 id="jornada-titulo" data-reveal style="--i:1">Uma jornada inteira, <em>conectada.</em></h2>
      <p data-reveal style="--i:2">
        Cada etapa conversa com a próxima para que o atendimento não seja uma coleção de ferramentas isoladas.
      </p>
    </header>

    <ol class="trilha" role="list">
      {
        etapas.map((e, i) => (
          <li class:list={["etapa", { "etapa--destaque": e.destaque }]} data-reveal style={`--i:${i % 3}`}>
            <div class="etapa-topo">
              <span class="etapa-num numero" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="icone">
                <Icon name={e.i} />
              </span>
            </div>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
            {i < etapas.length - 1 && (
              <span class="etapa-liga" aria-hidden="true">
                <Icon name="arrow-right" size={16} />
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <p class="jornada-ciclo" data-reveal>
      <Icon name="refresh" size={18} />
      E a cada retorno, a jornada continua de onde parou.
    </p>
  </div>
</section>

<style>
  .trilha {
    display: grid;
    gap: 1rem;
  }
  .etapa {
    position: relative;
    padding: 1.4rem 1.4rem 1.5rem;
    border-radius: var(--raio-card);
    background: #fff;
    border: 1px solid var(--borda);
    transition: transform 0.35s var(--ease), box-shadow 0.35s, border-color 0.35s;
  }
  .etapa:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra);
    border-color: var(--dourado-suave);
  }
  .etapa--destaque {
    background:
      radial-gradient(ellipse 80% 70% at 100% 0%, rgba(201, 163, 90, 0.18), transparent 60%),
      linear-gradient(165deg, var(--verde-escuro), var(--verde-noite));
    border-color: var(--linha);
    color: #ede8da;
  }
  .etapa--destaque h3 { color: var(--dourado-claro); }
  .etapa--destaque p { color: rgba(237, 232, 218, 0.72); }
  .etapa--destaque .icone { color: var(--dourado); }
  .etapa--destaque .etapa-num { color: var(--dourado); }

  .etapa-topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
  }
  .etapa-num {
    font-size: 2.1rem;
    font-weight: 500;
    color: var(--acento);
    opacity: 0.9;
  }
  .etapa .icone { width: 42px; height: 42px; }
  .etapa h3 {
    font-size: 1.4rem;
    margin-bottom: 0.35rem;
  }
  .etapa p {
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .etapa-liga {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: -1.05rem;
    translate: -50% 0;
    rotate: 90deg;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--creme-claro);
    border: 1px solid var(--linha);
    color: var(--acento);
  }

  .jornada-ciclo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    font-family: var(--fonte-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--acento);
    text-align: center;
  }

  @media (min-width: 640px) {
    .trilha { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
    .etapa-liga { display: none; }
  }
  @media (min-width: 1000px) {
    .trilha { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .etapa-liga {
      display: grid;
      left: auto;
      right: -1.5rem;
      top: 50%;
      bottom: auto;
      translate: 50% -50%;
      rotate: 0deg;
    }
    .etapa:nth-child(3n) .etapa-liga { display: none; }
  }
</style>
