---
/* O mecanismo em seis movimentos. Absorve a antiga "Jornada completa": cada
   movimento diz onde acontece na plataforma, numa seção só. */
import Icon, { type IconName } from "../ui/Icon.astro";

const passos: { t: string; d: string; i: IconName; onde: string[] }[] = [
  { t: "Mapear", d: "O paciente responde ao Mapeamento Holístico antes da consulta.", i: "map", onde: ["Mapeamento Holístico"] },
  { t: "Investigar", d: "No atendimento, o HOLOSCAN reúne os relatos em cinco territórios e mostra onde vale olhar com mais atenção.", i: "search", onde: ["Atendimento", "HOLOSCAN"] },
  { t: "Aprofundar", d: "Onde fizer sentido, você aplica ferramentas de Corpo, Mente e Espírito.", i: "layers", onde: ["Ferramentas"] },
  { t: "Estruturar", d: "O Playbook HOLOS reúne focos e estratégias possíveis para apoiar a sua decisão.", i: "compass", onde: ["Playbook HOLOS"] },
  { t: "Entregar", d: "Você constrói o Resultado HOLOS e o compartilha com o paciente em PDF.", i: "file", onde: ["Resultado HOLOS", "PDF / WhatsApp"] },
  { t: "Acompanhar", d: "No retorno, Antes e Agora aparecem lado a lado.", i: "refresh", onde: ["Retorno", "Evolução"] },
];
---

<section class="secao secao--creme-claro mecanismo" id="como-funciona" aria-labelledby="mecanismo-titulo">
  <div class="container">
    <header class="cabeca cabeca--centro">
      <span class="eyebrow" data-reveal>O mecanismo</span>
      <h2 id="mecanismo-titulo" data-reveal style="--i:1">
        Seis movimentos. <em>Um único raciocínio.</em>
      </h2>
      <p data-reveal style="--i:2">Cada etapa conversa com a próxima — da primeira informação ao retorno.</p>
    </header>

    <ol class="linha" role="list">
      {
        passos.map((p, i) => (
          <li class="passo" data-reveal style={`--i:${i}`}>
            <span class="passo-no" aria-hidden="true">
              <Icon name={p.i} size={20} />
            </span>
            <span class="passo-num numero" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
            <ul role="list" class="passo-onde" aria-label="Na plataforma">
              {p.onde.map((o) => <li>{o}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .linha {
    position: relative;
    display: grid;
    gap: 0;
  }
  /* mobile: linha vertical à esquerda */
  .linha::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 1px;
    background: linear-gradient(180deg, var(--dourado), rgba(201, 163, 90, 0.2));
  }
  .passo {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 1.25rem;
    padding-bottom: 2rem;
  }
  .passo > :not(.passo-no) { grid-column: 2; }
  .passo:last-child { padding-bottom: 0; }
  .passo-no {
    grid-row: 1 / span 4;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--dourado);
    background: var(--verde-escuro);
    color: var(--dourado);
    box-shadow: 0 0 0 6px var(--sup-fundo), 0 10px 24px rgba(6, 35, 26, 0.18);
  }
  .passo-num {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--acento);
    letter-spacing: 0.08em;
    padding-top: 0.2rem;
  }
  .passo h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0.15rem 0 0.4rem;
  }
  .passo p {
    color: var(--texto-suave);
    font-size: 0.95rem;
    max-width: 42ch;
  }
  .passo-onde {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }
  .passo-onde li {
    padding: 0.25rem 0.6rem;
    border-radius: var(--raio-pilula);
    border: 1px solid var(--linha);
    background: #fff;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--titulo);
    white-space: nowrap;
  }

  /* desktop: linha horizontal */
  @media (min-width: 1000px) {
    .linha {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.25rem;
    }
    .linha::before {
      left: calc(100% / 12);
      right: calc(100% / 12);
      top: 27px;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, rgba(201, 163, 90, 0.25), var(--dourado) 50%, rgba(201, 163, 90, 0.25));
    }
    .passo {
      grid-template-columns: 1fr;
      justify-items: center;
      align-content: start;
      text-align: center;
      padding: 0;
    }
    .passo > :not(.passo-no) { grid-column: auto; }
    .passo-no {
      grid-row: auto;
      width: 56px;
      height: 56px;
      margin-bottom: 1.25rem;
    }
    .passo h3 { font-size: 1.45rem; }
    .passo p { font-size: 0.9rem; }
    .passo-onde { justify-content: center; }
  }
</style>
