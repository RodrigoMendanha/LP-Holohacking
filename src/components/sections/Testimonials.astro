---
/* Prova social: só as imagens das mensagens reais do chat, em carrossel
   (TESTIMONIAL_IMAGES em data/site.ts). Arrasta no celular, setas e
   indicadores no desktop, e cada imagem amplia no visualizador.
   Lista vazia = seção oculta. */
import ZoomDialog from "../ui/ZoomDialog.astro";
import Icon from "../ui/Icon.astro";
import { TESTIMONIAL_IMAGES, TESTIMONIALS_CONTEXT } from "../../data/site";

const total = TESTIMONIAL_IMAGES.length;
---

{
  total > 0 && (
    <section class="secao secao--clara depoimentos" id="depoimentos" aria-labelledby="depoimentos-titulo">
      <div class="container">
        <header class="cabeca cabeca--centro">
          <span class="eyebrow" data-reveal>Prova social</span>
          <h2 id="depoimentos-titulo" data-reveal style="--i:1">
            O que nutricionistas disseram <em>ao conhecer o HoloHacking.</em>
          </h2>
          {TESTIMONIALS_CONTEXT && (
            <p data-reveal style="--i:2">
              {TESTIMONIALS_CONTEXT}
            </p>
          )}
        </header>
      </div>

      <div class="carrossel" data-carrossel role="region" aria-roledescription="carrossel" aria-label="Depoimentos" data-reveal>
        <div class="carrossel-trilho" data-carrossel-trilho tabindex="0" aria-label="Depoimentos, role para o lado">
          {TESTIMONIAL_IMAGES.map((t, i) => (
            <div class="carrossel-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${total}: ${t.name}`}>
              <a
                class="dep-imagem"
                href={t.src}
                data-zoom="depoimentos"
                data-zoom-titulo={t.name}
                data-zoom-legenda="Mensagem enviada no chat do encontro especial."
                data-zoom-alt={t.alt}
                aria-label={`Ampliar depoimento de ${t.name}`}
              >
                <img src={t.src} alt={t.alt} width="960" height="400" loading={i < 3 ? "eager" : "lazy"} decoding="async" />
              </a>
            </div>
          ))}
        </div>

        <div class="container carrossel-controles">
          <button type="button" class="carrossel-seta" data-carrossel-anterior aria-label="Depoimento anterior">
            <Icon name="arrow-left" size={18} />
          </button>
          <div class="carrossel-pontos" data-carrossel-pontos aria-hidden="true">
            {TESTIMONIAL_IMAGES.map((_, i) => <span class:list={["ponto", { ativo: i === 0 }]} />)}
          </div>
          <p class="carrossel-contador" data-carrossel-contador aria-live="polite">1 de {total}</p>
          <button type="button" class="carrossel-seta" data-carrossel-proximo aria-label="Próximo depoimento">
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </div>

      <ZoomDialog grupo="depoimentos" item="Depoimento" />
    </section>
  )
}

<style>
  .carrossel {
    position: relative;
  }
  .carrossel-trilho {
    display: flex;
    gap: clamp(0.9rem, 0.6rem + 1vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    /* começa alinhado ao conteúdo e deixa espiar o próximo */
    /* espaço para a sombra dos cards se dissipar: overflow-x também corta
       na vertical, e a sombra virava uma faixa retangular */
    padding: 2.5rem max(var(--gutter), calc((100vw - var(--container)) / 2)) 5rem;
    margin: -2rem 0 -3.5rem;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
    align-items: center;
  }
  .carrossel-trilho::-webkit-scrollbar { display: none; }
  .carrossel-trilho:focus-visible { outline-offset: -4px; }

  .carrossel-slide {
    flex: 0 0 min(86vw, 520px);
    scroll-snap-align: start;
  }
  .dep-imagem {
    display: block;
    border-radius: var(--raio-card);
    overflow: hidden;
    background: #252525;
    border: 1px solid rgba(201, 163, 90, 0.35);
    box-shadow: var(--sombra);
    cursor: zoom-in;
    transition: transform 0.35s var(--ease), border-color 0.35s, box-shadow 0.35s;
  }
  .dep-imagem:hover {
    transform: translateY(-4px);
    border-color: var(--dourado);
    box-shadow: var(--sombra-forte);
  }
  .dep-imagem img {
    width: 100%;
    height: auto;
  }

  .carrossel-controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .carrossel-seta {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--linha);
    background: var(--creme-claro);
    color: var(--titulo);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .carrossel-seta:hover:not(:disabled) {
    background: var(--verde-escuro);
    color: var(--dourado-claro);
    border-color: var(--verde-escuro);
  }
  .carrossel-seta:disabled { opacity: 0.35; cursor: default; }
  .carrossel-pontos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    max-width: 320px;
  }
  .ponto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--borda-forte);
    transition: background-color 0.25s, transform 0.25s;
  }
  .ponto.ativo {
    background: var(--dourado-texto);
    transform: scale(1.35);
  }
  .carrossel-contador {
    min-width: 5.5ch;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
    text-align: center;
  }

  @media (max-width: 639px) {
    .carrossel-pontos { display: none; }
  }
  @media (min-width: 640px) {
    .carrossel-contador { display: none; }
  }
  @media (min-width: 1100px) {
    .carrossel-slide { flex-basis: 460px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carrossel-trilho { scroll-behavior: auto; }
  }
</style>
