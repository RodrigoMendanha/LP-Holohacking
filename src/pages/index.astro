---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import VideoSection from "../components/sections/VideoSection.astro";
import ProblemSection from "../components/sections/ProblemSection.astro";
import MechanismSection from "../components/sections/MechanismSection.astro";
import JourneySection from "../components/sections/JourneySection.astro";
import MappingSection from "../components/sections/MappingSection.astro";
import HoloscanSection from "../components/sections/HoloscanSection.astro";
import ToolsSection from "../components/sections/ToolsSection.astro";
import PlaybookSection from "../components/sections/PlaybookSection.astro";
import ResultSection from "../components/sections/ResultSection.astro";
import EvolutionSection from "../components/sections/EvolutionSection.astro";
import BenefitsSection from "../components/sections/BenefitsSection.astro";
import ProfessionalControlSection from "../components/sections/ProfessionalControlSection.astro";
import AudienceSection from "../components/sections/AudienceSection.astro";
import ProductGallery from "../components/sections/ProductGallery.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import CreatorSection from "../components/sections/CreatorSection.astro";
import OfferSection from "../components/sections/OfferSection.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import { SHOW_VSL } from "../data/site";
---

<BaseLayout>
  <div id="topo"></div>
  <Header />
  <main id="conteudo">
    <Hero />
    {SHOW_VSL && <VideoSection />}
    <ProblemSection />
    <MechanismSection />
    <JourneySection />
    <MappingSection />
    <HoloscanSection />
    <ToolsSection />
    <PlaybookSection />
    <ResultSection />
    <EvolutionSection />
    <BenefitsSection />
    <ProfessionalControlSection />
    <AudienceSection />
    <ProductGallery />
    <Testimonials />
    <CreatorSection />
    <OfferSection />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
